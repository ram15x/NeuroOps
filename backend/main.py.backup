from fastapi import FastAPI
from backend.api import features, agent, streaming
from backend.api import pipeline
from backend.api import features
from backend.api import pipeline
from fastapi.middleware.cors import CORSMiddleware
from fastapi.staticfiles import StaticFiles
# from slowapi import Limiter, _rate_limit_exceeded_handler
# from slowapi.util import get_remote_address
# from slowapi.errors import RateLimitExceeded
from backend.api import features, agent, streaming, incidents, aws
from backend.api import pipeline
from backend.api import features
from backend.api import pipeline
from backend.core.config import settings
from backend.core.logger import get_logger
from backend.services.metrics_analyzer import start_metrics_analyzer
import os

logger = get_logger(__name__)

app = FastAPI(title="NeuroOps", version="2.0.0")

# CORS - single configuration
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*", "sec-websocket-key", "sec-websocket-version", "sec-websocket-extensions"],
)

# Mount static dashboard
if os.path.exists("dashboard"):
    app.mount("/dashboard", StaticFiles(directory="dashboard", html=True), name="dashboard")

# Include routers
app.include_router(streaming.router, prefix="/api/v1", tags=["Streaming"])
app.include_router(agent.router, prefix="/api/v1", tags=["Agent"])
app.include_router(incidents.router, prefix="/api/v1", tags=["Incidents"])
app.include_router(agent.router, prefix="/api/v1", tags=["Agent"])
app.include_router(aws.router, prefix="/api/v1", tags=["AWS"])
app.include_router(agent.router, prefix="/api/v1", tags=["Agent"])

# Import other routers
from backend.api import features, agent, auth, inframind, opsgpt, failure, scalewise, autohealing, buildsense, deployguard, registry, rootcause
from backend.api import pipeline
from backend.api import features
from backend.api import pipeline
app.include_router(auth.router, prefix="/api/v1", tags=["Auth"])
app.include_router(agent.router, prefix="/api/v1", tags=["Agent"])
