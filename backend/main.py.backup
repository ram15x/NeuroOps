app.include_router(agent.router, prefix="/api/v1", tags=["Agent"])
app.include_router(streaming.router, prefix="/api/v1", tags=["Live Streaming"])
app.include_router(agent.router, prefix="/api/v1", tags=["Agent"])

@app.on_event("startup")
async def startup():
    logger.info(f"NeuroOps v{settings.APP_VERSION} started")
    start_metrics_analyzer()

@app.get("/health")
async def health():
    return {"status": "healthy"}

@app.get("/")
async def root():
    return {"platform": "NeuroOps", "version": "2.0.0", "api": "/api/v1", "docs": "/docs"}

# Register missing routers
try:
    from backend.api import features
    app.include_router(features.router, prefix="/api/v1", tags=["Features"])
    print("✅ Features router registered")
except Exception as e:
    print(f"⚠️ Features router failed: {e}")

try:
    from backend.api import pipeline
    app.include_router(pipeline.router, prefix="/api/v1", tags=["Pipeline"])
    print("✅ Pipeline router registered")
except Exception as e:
    print(f"⚠️ Pipeline router failed: {e}")

try:
    from backend.api import incidents
    app.include_router(incidents.router, prefix="/api/v1", tags=["Incidents"])
    print("✅ Incidents router registered")
